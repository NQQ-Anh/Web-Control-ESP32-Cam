SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Ho_Chi_Minh
DEVICE_TOKEN_SECRET=replace-with-at-least-32-random-characters
DEVICE_OFFLINE_MAX_AGE_SECONDS=300
DEVICE_OFFLINE_THRESHOLD_SECONDS=120
AUTH_INVITE_REDIRECT_URL=http://localhost:5173/invite
AUTH_SIGNUP_REDIRECT_URL=http://localhost:5173/login?confirmed=1
TRUST_PROXY=false
